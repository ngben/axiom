{
    "time_units": "minutes since 1950-01-01 00:00:00",
    "reference_time": "1950-01-01 00:00:00",
    "xarray": {
        "open_dataset": {
            "engine": "h5netcdf",
            "chunks": {
                "time": 100
            }
        }
    },
    "dask": {
        "enable": true,
        "engine": "h5netcdf",
        "restart_client_between_variables": false,
        "restart_timeout_seconds": 120,
        "cluster": {
            "n_workers": 1
        }
    },
    "filename_filtering": {
        "variable": true,
        "variable_regex": "^%(variable)s_",
        "year": true,
        "year_offset": 1
    },
    "dump_filepaths_prior_to_loading": true,
    "auto_detect_ccam": false,
    "allow_subdaily_resampling": false,
    "rolling_time_averaging": true,
    "rerun_failures": false,
    "rerun_attempts": 3,
    "processing_timeout_seconds": 1200, 
    "derive_filename_times_from_data": true,
    "copy_coordinates_from_inputs": true,
    "detect_output_frequency_from_inputs": true,
    "default_schema": "CORDEX-SHEP",
    "historical_cutoff": 2014,
    "enable_historical_cutoff": false,
    "track_failures": true,
    "metadata_defaults": {
        "Conventions": "%(Conventions)s",
        "activity_id": "%(activity_id)s",
        "contact": "%(contact)s",
        "creation_date": "%(creation_date)s",
        "domain": "%(domain)s",
        "domain_id": "%(domain_id)s",
        "driving_institution_id": "%(driving_institution_id)s",
        "driving_source_id": "%(driving_source_id)s",
        "driving_variant_label": "%(driving_variant_label)s",
        "frequency": "%(frequency_mapping)s",
        "institution": "%(institution)s",
        "institution_id": "%(institution_id)s",
        "license": "%(license)s",
        "mip_era": "%(mip_era)s",
        "grid": "%(grid)s",
        "product": "%(product)s",
        "project_id": "%(project_id)s",
        "source": "%(source)s",
        "source_id": "%(source_id)s",
        "source_type": "%(source_type)s",
        "version_realization": "%(version_realization)s",
        "tracking_id": "%(uuid)s",
        "variable_id": "%(variable)s",
        "doi": "%(doi)s",
        "references": "%(references)s",
        "variable_version": "%(version)s"
    },
    "frequency_mapping":{
        "5min": "5min",
        "3H": "3hr",
        "1D": "day",
        "1M": "mon",
        "1H": "1hr",
        "6H": "6hr",
        "fx": "fx"
    },
    "output_format": "NETCDF4_CLASSIC",
    "encoding": {
        "variables": {
            "dtype": "float32",
            "_FillValue": 1e20,
            "missing_value": 1e20,
            "zlib": true,
            "complevel": 1
        },
        "lon": {
            "_FillValue": 1e20,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "lev": {
            "_FillValue": 1e20,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "lat": {
            "_FillValue": 1e20,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "lat_bnds": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "lon_bnds": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "depth": {
            "_FillValue": 1e20,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "time": {
            "_FillValue": 1e20,
            "dtype": "double",
            "units": "minutes since 1950-01-01 00:00:00",
            "zlib": true,
            "complevel": 1
        },
        "time_bnds": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "crs": {
            "_FillValue": null,
            "dtype": "int",
            "zlib": true,
            "complevel": 1
        },
        "h2": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "h10": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "h50": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "h100": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "h150": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "h200": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "h250": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "h300": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "p1000": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "p925": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "p850": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "p700": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "p600": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "p500": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "p400": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "p300": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "p250": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        },
        "p200": {
            "_FillValue": null,
            "dtype": "double",
            "zlib": true,
            "complevel": 1
        }
    },
    "templates": {
        "drs_base": "%(institution_id)s/%(gcm_institute)s-%(gcm_model)s/%(driving_experiment_id)s/%(driving_variant_label)s/%(institution_id)s-%(source_id)s/%(version_realization)s",
        "drs_path": "%(output_directory)s/%(project_id)s/Models/%(domain_id)s/%(event_id)s/%(driving_source_id)s/%(driving_variant_label)s/%(institution_id)s/%(source_id)s/%(version_realization)s/%(frequency_mapping)s/%(variable)s/%(version)s",
        "filename": "%(variable)s_%(domain_id)s_%(event_id)s_%(driving_source_id)s_%(driving_variant_label)s_%(institution_id)s_%(source_id)s_%(version_realization)s_%(frequency_mapping)s_%(start_date)s-%(end_date)s.nc",
        "filename_fixed": "%(variable)s_%(domain_id)s_%(event_id)s_%(driving_source_id)s_%(driving_variant_label)s_%(institution_id)s_%(source_id)s_%(version_realization)s_fx.nc"
    },
    "automatic_error_recovery": true,
    "automatic_error_recovery_count": 1,
    "recoverable_errors": [
        "AttributeError: 'NoneType' object has no attribute 'lock_acquire'"
    ],
    "launch": {
        "directives": [
            "-N %(job_name)s",
            "-v %(qsub_vars)s",
            "-o %(log_dir)s",
            "-e %(log_dir)s"
        ]
    }
}
